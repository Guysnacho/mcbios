# Supabase project (anon key only: no service-role key and no Stripe secret key on this site)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUB_KEY=

# The MCBIOS org id in the Conference Suite
NEXT_PUBLIC_ORG_ID=
# This site's origin; must match the org's base_url in the suite or CORS fails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: defaults to https://www.conferencesuite.net (use http://localhost:3001 for a local suite)
NEXT_PUBLIC_SUITE_URL=

# Conference Suite form id for session proposals (empty = Google Form fallback)
NEXT_PUBLIC_PROPOSAL_FORM_ID=
